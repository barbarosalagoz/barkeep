{
  "name": "barkeep",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.5.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @barkeep/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace @barkeep/web",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @barkeep/web",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "demo:sep": "npm run demo:sep --workspace @barkeep/web"
  }
}
