# PromptRail network + anchor configuration (all optional; defaults = Testnet mock anchor).
# Copy to .env.local to override. Only VITE_* vars reach the browser bundle.

# "testnet" (default) or "public". Switches the wallet gate, Horizon, the
# explorer links and the network passphrase the anchor's stellar.toml must match.
VITE_STELLAR_NETWORK=testnet

# Home domain of the SEP anchor. Everything else (auth endpoint, transfer
# server, quote server, asset issuer, signing key) is discovered from
# https://<domain>/.well-known/stellar.toml at runtime.
VITE_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# On-chain asset the anchor ramps and the fiat leg (ISO 4217).
VITE_ANCHOR_ASSET_CODE=USDC
VITE_ANCHOR_FIAT_CODE=TRY

# Show the "simulate bank transfer" sandbox button. Ignored on public.
VITE_ANCHOR_SANDBOX=true

# Optional Horizon override (defaults follow VITE_STELLAR_NETWORK).
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org
