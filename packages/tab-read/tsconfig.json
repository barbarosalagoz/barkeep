{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    /*
     * ES2023 only: no "dom", no "node" types. This package runs in the MCP
     * server (Node) and in the bill (a browser), so anything either side
     * lacks -- Buffer, fs, window -- must fail here, at typecheck, not at
     * runtime on the other side.
     */
    "lib": ["ES2023"],
    "types": [],
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
